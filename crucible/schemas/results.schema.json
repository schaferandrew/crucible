{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/schaferandrew/crucible/blob/main/crucible/schemas/results.schema.json",
  "title": "Crucible results bundle",
  "description": "What `crucible export` and `crucible publish` write, and what the portfolio's Crucible page reads. Every *.json file in the page's _data/crucible/ folder is one bundle; the page merges them (runs by run_id, the newest bundle wins) and takes the test list from the newest bundle.",
  "type": "object",
  "required": [
    "format_version",
    "generated_at",
    "tests",
    "runs",
    "modes",
    "tiers"
  ],
  "properties": {
    "format_version": {
      "type": "integer",
      "enum": [
        2
      ]
    },
    "generated_at": {
      "type": "string",
      "description": "ISO 8601 time the bundle was written"
    },
    "source": {
      "type": "object",
      "description": "Where the bundle came from",
      "properties": {
        "machine": {
          "type": "string"
        },
        "crucible_version": {
          "type": "string",
          "description": "The crucible version that wrote the bundle"
        }
      }
    },
    "release": {
      "type": [
        "object",
        "null"
      ]
    },
    "agent_score_caveat": {
      "type": "string"
    },
    "harnesses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "tiers": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "spark",
          "temper",
          "forge"
        ]
      }
    },
    "category_weights": {
      "type": "object"
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "harnesses",
          "areas"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "chat",
              "agentic"
            ]
          },
          "label": {
            "type": "string"
          },
          "harnesses": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "areas": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "id",
                "label"
              ]
            }
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "mode",
          "area",
          "tier",
          "status",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ],
            "description": "Human-readable name of the test, when it has one"
          },
          "mode": {
            "type": "string",
            "enum": [
              "chat",
              "agentic"
            ]
          },
          "area": {
            "type": "string"
          },
          "tier": {
            "type": "string",
            "enum": [
              "spark",
              "temper",
              "forge"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "provisional",
              "active",
              "retired"
            ]
          },
          "version": {
            "type": "integer"
          },
          "rubric_version": {
            "type": "integer"
          },
          "summary": {
            "type": "string"
          },
          "prompt": {
            "type": "string",
            "description": "The full prompt the model is given"
          },
          "scoring": {
            "type": "string",
            "enum": [
              "checks",
              "judge"
            ]
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "test_id",
          "harness",
          "model",
          "started_at",
          "counts"
        ],
        "properties": {
          "run_id": {
            "type": "string",
            "description": "<model_slug>/<category>/<test_id>/<timestamp>; unique across bundles"
          },
          "test_id": {
            "type": "string"
          },
          "harness": {
            "type": "string"
          },
          "model": {
            "type": "string",
            "description": "provider/model"
          },
          "started_at": {
            "type": "string"
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "outcome": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "completed",
              "failed",
              "no_answer",
              "timeout",
              "context_limit",
              "harness_error",
              null
            ]
          },
          "elapsed_s": {
            "type": [
              "number",
              "null"
            ]
          },
          "score": {
            "type": [
              "number",
              "null"
            ],
            "description": "Human score, 0-10"
          },
          "check_score": {
            "type": [
              "number",
              "null"
            ],
            "description": "Programmatic checks, 0-10"
          },
          "agent_score": {
            "type": [
              "number",
              "null"
            ],
            "description": "AI judge, 0-10"
          },
          "counts": {
            "type": "boolean",
            "description": "Current test version and an active test"
          },
          "hardware": {
            "type": [
              "object",
              "null"
            ],
            "description": "The machine that ran the model: hostname, cpu, gpu, ram_gb; null for cloud runs"
          },
          "inference": {
            "type": [
              "object",
              "null"
            ]
          },
          "output": {
            "type": [
              "string",
              "null"
            ],
            "description": "The model's final answer, clipped"
          },
          "criteria": {
            "type": [
              "array",
              "null"
            ],
            "description": "Per-criterion automatic scores: criterion, max_score, score, detail"
          },
          "hidden_tests": {
            "type": [
              "object",
              "null"
            ],
            "description": "Hidden acceptance test results (Forge coding tests)"
          },
          "reasoning": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "default",
              "off",
              "low",
              "medium",
              "high",
              null
            ],
            "description": "Reasoning level the run asked for; each level is its own model"
          },
          "reasoning_chars": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Characters of reasoning the model streamed (direct runs)"
          },
          "run_uuid": {
            "type": [
              "string",
              "null"
            ],
            "description": "Permanent run identity (UUIDv4), minted when the run started; null for runs recorded before 2.4.0"
          },
          "provenance": {
            "type": [
              "object",
              "null"
            ],
            "description": "Which crucible produced the run",
            "properties": {
              "crucible_version": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "crucible_commit": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Short git SHA of the checkout; null outside git"
              },
              "crucible_dirty": {
                "type": [
                  "boolean",
                  "null"
                ],
                "description": "Uncommitted changes under crucible/, prompts/, graders/, fixtures/ or repos/"
              },
              "machine_id": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Random ID minted once per machine; never the hostname"
              }
            }
          },
          "model_variant": {
            "type": [
              "object",
              "null"
            ],
            "description": "The weights as a variant, and the reasoning level they ran at",
            "properties": {
              "publisher": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "format": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "gguf, mlx, ..."
              },
              "quant": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "reasoning_resolved": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The level the model actually ran at; null when it can't be told"
              }
            }
          },
          "hardware_key": {
            "type": [
              "string",
              "null"
            ],
            "description": "The device that ran the weights (m1-pro-32gb, rtx-5070-ti-16gb); null for cloud runs"
          },
          "endpoint": {
            "type": [
              "object",
              "null"
            ],
            "description": "Who served a cloud request",
            "properties": {
              "upstream": {
                "type": [
                  "object",
                  "null"
                ],
                "description": "The provider OpenRouter routed to: name, quant"
              },
              "resolved_model": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The model id the provider reported serving"
              }
            }
          }
        }
      }
    }
  }
}
