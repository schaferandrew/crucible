{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/schaferandrew/crucible/blob/main/crucible/schemas/catalog.schema.json",
  "title": "Crucible suite catalog (bundle format 3)",
  "description": "What one suite is: _data/crucible/catalog/<suite>.json. Every label, threshold and weight the dashboard shows comes from here; see docs/bundle-format.md.",
  "type": "object",
  "required": [
    "format_version",
    "format_revision",
    "suite",
    "scoring_policy",
    "modes",
    "areas",
    "categories",
    "tiers",
    "harnesses",
    "tasks"
  ],
  "properties": {
    "format_version": {
      "type": "integer",
      "enum": [
        3
      ]
    },
    "format_revision": {
      "type": "integer"
    },
    "suite": {
      "type": "object",
      "required": [
        "id",
        "version",
        "status"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "cut_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string"
        },
        "changelog_url": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "crucible_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "scoring_policy": {
      "type": "object"
    },
    "modes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "blurb": {
            "type": [
              "string",
              "null"
            ]
          },
          "order": {
            "type": "integer"
          }
        }
      }
    },
    "areas": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "mode"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "mode": {
            "type": "string"
          },
          "order": {
            "type": "integer"
          }
        }
      }
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "weight"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "weight": {
            "type": "number"
          }
        }
      }
    },
    "tiers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "blurb": {
            "type": [
              "string",
              "null"
            ]
          },
          "order": {
            "type": "integer"
          },
          "role": {
            "type": [
              "string",
              "null"
            ]
          },
          "gate": {
            "type": "object"
          }
        }
      }
    },
    "harnesses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "modes"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": [
              "string",
              "null"
            ]
          },
          "modes": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "aliases",
          "mode",
          "area",
          "category",
          "tier",
          "status",
          "version"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "mode": {
            "type": "string"
          },
          "area": {
            "type": [
              "string",
              "null"
            ]
          },
          "category": {
            "type": [
              "string",
              "null"
            ]
          },
          "tier": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string"
          },
          "version": {
            "type": [
              "integer",
              "null"
            ]
          },
          "rubric_version": {
            "type": [
              "integer",
              "null"
            ]
          },
          "weight": {
            "type": [
              "number",
              "null"
            ]
          },
          "scoring": {
            "type": "object"
          },
          "criteria": {
            "type": "array"
          },
          "summary": {
            "type": [
              "string",
              "null"
            ]
          },
          "prompt": {
            "type": [
              "string",
              "null"
            ]
          },
          "rules": {
            "type": "array"
          },
          "added_in": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
